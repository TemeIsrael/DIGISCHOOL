{
  "name": "ecole-app",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @ecole-app/web dev",
    "dev:all": "pnpm --filter @ecole-app/api dev & pnpm --filter @ecole-app/web dev",
    "build": "pnpm --filter @ecole-app/shared build && pnpm --filter @ecole-app/api build && pnpm --filter @ecole-app/web build",
    "test": "pnpm --filter @ecole-app/api test & pnpm --filter @ecole-app/web test",
    "test:ui": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^20.19.41",
    "mysql2": "^3.22.3",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3"
  }
}
